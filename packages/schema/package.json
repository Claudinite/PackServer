{
  "name": "@packserver/schema",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "wrangler d1 migrations apply registry --config wrangler.jsonc",
    "gen:range": "node scripts/gen-range.mjs"
  },
  "dependencies": {
    "zod": "catalog:",
    "drizzle-orm": "catalog:"
  },
  "devDependencies": {
    "drizzle-kit": "catalog:",
    "wrangler": "catalog:"
  }
}

{
  "name": "validator-local",
  "workers_dev": false,
  "preview_urls": false,
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "env": {
    "test": {
      "name": "validator-test",
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "WORKER": "validator",
        "ENVIRONMENT": "test",
        "STEP_RETRY_DELAY": "10 milliseconds",
        "RESCAN_BATCH": "25",
        "WAIT_REARM": "3 seconds",
        "SITE_ORIGINS": "http://web.internal",
        "SIGNING_KEY_ACTIVE": "BQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQUFBQU",
        "SELFTEST_HMAC_KEY": "test-selftest-hmac-key",
        "IP_HASH_MASTER_KEY": "test-ip-hash-master-key",
        "PRINCIPAL_HASH_KEY": "test-principal-hash-key"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "registry-test",
          "database_id": "00000000-0000-0000-0000-010000000001",
          "migrations_dir": "../../packages/schema/migrations"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "TELEMETRY_KV",
          "id": "00000000000000000000020000000007"
        }
      ],
      "r2_buckets": [
        {
          "binding": "PACKS_STAGING",
          "bucket_name": "packs-staging-test"
        },
        {
          "binding": "PACKS_PUBLIC",
          "bucket_name": "packs-public-test"
        },
        {
          "binding": "PACKS_PRIVATE",
          "bucket_name": "packs-private-test"
        },
        {
          "binding": "VALIDATION_REPORTS",
          "bucket_name": "validation-reports-test"
        },
        {
          "binding": "OPS_BUCKET",
          "bucket_name": "ops-test"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "NOTIFY_QUEUE",
            "queue": "notify-test"
          },
          {
            "binding": "REINDEX_QUEUE",
            "queue": "reindex-test"
          }
        ],
        "consumers": [
          {
            "queue": "notify-test",
            "max_batch_size": 10,
            "max_batch_timeout": 1,
            "max_retries": 5,
            "dead_letter_queue": "notify-dlq-test"
          },
          {
            "queue": "reindex-test",
            "max_batch_size": 10,
            "max_batch_timeout": 1,
            "max_retries": 5,
            "dead_letter_queue": "reindex-dlq-test"
          }
        ]
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "SCOPE_COORDINATOR",
            "class_name": "ScopeCoordinator",
            "script_name": "publish-test"
          },
          {
            "name": "ROOT_COORDINATOR",
            "class_name": "RootCoordinator",
            "script_name": "publish-test"
          }
        ]
      },
      "workflows": [
        {
          "binding": "VALIDATE_PACK",
          "name": "validate-pack-test",
          "class_name": "ValidatePackWorkflow"
        }
      ],
      "exports": {
        "SandboxA": {
          "type": "durable-object",
          "storage": "sqlite"
        },
        "SandboxB": {
          "type": "durable-object",
          "storage": "sqlite"
        },
        "ValidatePackWorkflow": {
          "type": "workflow",
          "name": "validate-pack"
        }
      },
      "services": [
        {
          "binding": "GITHUB",
          "service": "github-test"
        },
        {
          "binding": "AI",
          "service": "fake-ai"
        },
        {
          "binding": "VECTORIZE",
          "service": "fake-vectorize"
        },
        {
          "binding": "SANDBOX_A",
          "service": "fake-sandbox-a"
        },
        {
          "binding": "SANDBOX_B",
          "service": "fake-sandbox-b"
        }
      ],
      "analytics_engine_datasets": [
        {
          "binding": "REQUEST_OUTCOMES",
          "dataset": "request_outcomes_test"
        },
        {
          "binding": "DOMAIN_EVENTS",
          "dataset": "domain_events_test"
        },
        {
          "binding": "VALIDATION_EVENTS",
          "dataset": "validation_events_test"
        }
      ],
      "version_metadata": {
        "binding": "CF_VERSION_METADATA"
      }
    },
    "staging": {
      "name": "validator-staging",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        {
          "pattern": "registry-staging.claudinite.com/validator/__selftest",
          "zone_name": "claudinite.com"
        }
      ],
      "triggers": {
        "crons": [
          "0 4 * * *",
          "0 5 * * 1",
          "*/5 * * * *",
          "*/15 * * * *"
        ]
      },
      "vars": {
        "WORKER": "validator",
        "ENVIRONMENT": "staging",
        "STEP_RETRY_DELAY": "30 seconds",
        "RESCAN_BATCH": "25",
        "WAIT_REARM": "7 days",
        "SITE_ORIGINS": "https://registry-staging.claudinite.com",
        "MAIL_FROM": "noreply@claudinite.com"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "registry-staging",
          "database_id": "00000000-0000-0000-0000-110000000001",
          "migrations_dir": "../../packages/schema/migrations"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "TELEMETRY_KV",
          "id": "00000000000000000000120000000007"
        }
      ],
      "r2_buckets": [
        {
          "binding": "PACKS_STAGING",
          "bucket_name": "packs-staging-staging"
        },
        {
          "binding": "PACKS_PUBLIC",
          "bucket_name": "packs-public-staging"
        },
        {
          "binding": "PACKS_PRIVATE",
          "bucket_name": "packs-private-staging"
        },
        {
          "binding": "VALIDATION_REPORTS",
          "bucket_name": "validation-reports-staging"
        },
        {
          "binding": "OPS_BUCKET",
          "bucket_name": "ops-staging"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "NOTIFY_QUEUE",
            "queue": "notify-staging"
          },
          {
            "binding": "REINDEX_QUEUE",
            "queue": "reindex-staging"
          }
        ],
        "consumers": [
          {
            "queue": "notify-staging",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 5,
            "dead_letter_queue": "notify-dlq-staging"
          },
          {
            "queue": "reindex-staging",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 5,
            "dead_letter_queue": "reindex-dlq-staging"
          }
        ]
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "SCOPE_COORDINATOR",
            "class_name": "ScopeCoordinator",
            "script_name": "publish-staging"
          },
          {
            "name": "ROOT_COORDINATOR",
            "class_name": "RootCoordinator",
            "script_name": "publish-staging"
          },
          {
            "name": "SANDBOX_A",
            "class_name": "SandboxA"
          },
          {
            "name": "SANDBOX_B",
            "class_name": "SandboxB"
          }
        ]
      },
      "workflows": [
        {
          "binding": "VALIDATE_PACK",
          "name": "validate-pack-staging",
          "class_name": "ValidatePackWorkflow"
        }
      ],
      "exports": {
        "SandboxA": {
          "type": "durable-object",
          "storage": "sqlite"
        },
        "SandboxB": {
          "type": "durable-object",
          "storage": "sqlite"
        },
        "ValidatePackWorkflow": {
          "type": "workflow",
          "name": "validate-pack-staging"
        }
      },
      "containers": [
        {
          "class_name": "SandboxA",
          "image": "../../sandbox/image-a/Dockerfile",
          "instance_type": "basic",
          "max_instances": 2
        },
        {
          "class_name": "SandboxB",
          "image": "../../sandbox/image-b/Dockerfile",
          "instance_type": "basic",
          "max_instances": 2
        }
      ],
      "vectorize": [
        {
          "binding": "VECTORIZE",
          "index_name": "packs-staging"
        }
      ],
      "ai": {
        "binding": "AI"
      },
      "services": [
        {
          "binding": "GITHUB",
          "service": "github-staging"
        }
      ],
      "analytics_engine_datasets": [
        {
          "binding": "REQUEST_OUTCOMES",
          "dataset": "request_outcomes_staging"
        },
        {
          "binding": "DOMAIN_EVENTS",
          "dataset": "domain_events_staging"
        },
        {
          "binding": "VALIDATION_EVENTS",
          "dataset": "validation_events_staging"
        }
      ],
      "secrets_store_secrets": [
        {
          "binding": "SIGNING_KEY_ACTIVE",
          "store_id": "00000000000000000000190000000004",
          "secret_name": "signing-key-active-staging"
        },
        {
          "binding": "SELFTEST_HMAC_KEY",
          "store_id": "00000000000000000000190000000004",
          "secret_name": "selftest-hmac-key-staging"
        },
        {
          "binding": "IP_HASH_MASTER_KEY",
          "store_id": "00000000000000000000190000000004",
          "secret_name": "ip-hash-master-key-staging"
        },
        {
          "binding": "PRINCIPAL_HASH_KEY",
          "store_id": "00000000000000000000190000000004",
          "secret_name": "principal-hash-key-staging"
        }
      ],
      "send_email": [
        {
          "name": "EMAIL"
        }
      ],
      "version_metadata": {
        "binding": "CF_VERSION_METADATA"
      }
    },
    "production": {
      "name": "validator",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        {
          "pattern": "registry-canary.claudinite.com/validator/__selftest",
          "zone_name": "claudinite.com"
        }
      ],
      "triggers": {
        "crons": [
          "0 4 * * *",
          "0 5 * * 1",
          "*/5 * * * *",
          "*/15 * * * *"
        ]
      },
      "vars": {
        "WORKER": "validator",
        "ENVIRONMENT": "production",
        "STEP_RETRY_DELAY": "30 seconds",
        "RESCAN_BATCH": "25",
        "WAIT_REARM": "7 days",
        "SITE_ORIGINS": "https://registry.claudinite.com",
        "MAIL_FROM": "noreply@claudinite.com"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "registry",
          "database_id": "00000000-0000-0000-0000-210000000001",
          "migrations_dir": "../../packages/schema/migrations"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "TELEMETRY_KV",
          "id": "00000000000000000000220000000007"
        }
      ],
      "r2_buckets": [
        {
          "binding": "PACKS_STAGING",
          "bucket_name": "packs-staging"
        },
        {
          "binding": "PACKS_PUBLIC",
          "bucket_name": "packs-public"
        },
        {
          "binding": "PACKS_PRIVATE",
          "bucket_name": "packs-private"
        },
        {
          "binding": "VALIDATION_REPORTS",
          "bucket_name": "validation-reports"
        },
        {
          "binding": "OPS_BUCKET",
          "bucket_name": "ops"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "NOTIFY_QUEUE",
            "queue": "notify"
          },
          {
            "binding": "REINDEX_QUEUE",
            "queue": "reindex"
          }
        ],
        "consumers": [
          {
            "queue": "notify",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 5,
            "dead_letter_queue": "notify-dlq"
          },
          {
            "queue": "reindex",
            "max_batch_size": 10,
            "max_batch_timeout": 5,
            "max_retries": 5,
            "dead_letter_queue": "reindex-dlq"
          }
        ]
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "SCOPE_COORDINATOR",
            "class_name": "ScopeCoordinator",
            "script_name": "publish"
          },
          {
            "name": "ROOT_COORDINATOR",
            "class_name": "RootCoordinator",
            "script_name": "publish"
          },
          {
            "name": "SANDBOX_A",
            "class_name": "SandboxA"
          },
          {
            "name": "SANDBOX_B",
            "class_name": "SandboxB"
          }
        ]
      },
      "workflows": [
        {
          "binding": "VALIDATE_PACK",
          "name": "validate-pack",
          "class_name": "ValidatePackWorkflow"
        }
      ],
      "exports": {
        "SandboxA": {
          "type": "durable-object",
          "storage": "sqlite"
        },
        "SandboxB": {
          "type": "durable-object",
          "storage": "sqlite"
        },
        "ValidatePackWorkflow": {
          "type": "workflow",
          "name": "validate-pack"
        }
      },
      "containers": [
        {
          "class_name": "SandboxA",
          "image": "../../sandbox/image-a/Dockerfile",
          "instance_type": "basic",
          "max_instances": 10
        },
        {
          "class_name": "SandboxB",
          "image": "../../sandbox/image-b/Dockerfile",
          "instance_type": "basic",
          "max_instances": 10
        }
      ],
      "vectorize": [
        {
          "binding": "VECTORIZE",
          "index_name": "packs"
        }
      ],
      "ai": {
        "binding": "AI"
      },
      "services": [
        {
          "binding": "GITHUB",
          "service": "github"
        }
      ],
      "analytics_engine_datasets": [
        {
          "binding": "REQUEST_OUTCOMES",
          "dataset": "request_outcomes"
        },
        {
          "binding": "DOMAIN_EVENTS",
          "dataset": "domain_events"
        },
        {
          "binding": "VALIDATION_EVENTS",
          "dataset": "validation_events"
        }
      ],
      "secrets_store_secrets": [
        {
          "binding": "SIGNING_KEY_ACTIVE",
          "store_id": "00000000000000000000290000000004",
          "secret_name": "signing-key-active"
        },
        {
          "binding": "SELFTEST_HMAC_KEY",
          "store_id": "00000000000000000000290000000004",
          "secret_name": "selftest-hmac-key"
        },
        {
          "binding": "IP_HASH_MASTER_KEY",
          "store_id": "00000000000000000000290000000004",
          "secret_name": "ip-hash-master-key"
        },
        {
          "binding": "PRINCIPAL_HASH_KEY",
          "store_id": "00000000000000000000290000000004",
          "secret_name": "principal-hash-key"
        }
      ],
      "send_email": [
        {
          "name": "EMAIL"
        }
      ],
      "version_metadata": {
        "binding": "CF_VERSION_METADATA"
      }
    }
  }
}

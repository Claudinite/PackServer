{
  "name": "publish-local",
  "workers_dev": false,
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "env": {
    "test": {
      "name": "publish-test",
      "workers_dev": false,
      "vars": {
        "WORKER": "publish",
        "ENVIRONMENT": "test",
        "SELFTEST_HMAC_KEY": "test-selftest-hmac-key",
        "STAGING_S3_ACCESS_KEY_ID": "test-staging-access-key",
        "STAGING_S3_SECRET_ACCESS_KEY": "test-staging-secret-key",
        "STAGING_S3_ENDPOINT": "https://test-account.r2.cloudflarestorage.com/packs-staging-test",
        "OIDC_ISSUER": "https://oidc.test",
        "OIDC_JWKS_URL": "https://oidc.test/.well-known/jwks",
        "IP_HASH_MASTER_KEY": "test-ip-hash-master-key",
        "PRINCIPAL_HASH_KEY": "test-principal-hash-key"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "registry-test",
          "database_id": "00000000-0000-0000-0000-010000000001",
          "migrations_dir": "../../packages/schema/migrations"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "CACHE_KV",
          "id": "00000000000000000000020000000003"
        },
        {
          "binding": "TELEMETRY_KV",
          "id": "00000000000000000000020000000007"
        }
      ],
      "r2_buckets": [
        {
          "binding": "PACKS_STAGING",
          "bucket_name": "packs-staging-test"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "NOTIFY_QUEUE",
            "queue": "notify-test"
          }
        ]
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "SCOPE_COORDINATOR",
            "class_name": "ScopeCoordinator"
          },
          {
            "name": "QUOTA",
            "class_name": "Quota"
          },
          {
            "name": "ROOT_COORDINATOR",
            "class_name": "RootCoordinator"
          }
        ]
      },
      "exports": {
        "ScopeCoordinator": {
          "type": "durable-object",
          "storage": "sqlite"
        },
        "Quota": {
          "type": "durable-object",
          "storage": "sqlite"
        },
        "RootCoordinator": {
          "type": "durable-object",
          "storage": "sqlite"
        }
      },
      "services": [
        {
          "binding": "VALIDATOR",
          "service": "validator-test"
        }
      ],
      "analytics_engine_datasets": [
        {
          "binding": "REQUEST_OUTCOMES",
          "dataset": "request_outcomes_test"
        },
        {
          "binding": "DOMAIN_EVENTS",
          "dataset": "domain_events_test"
        }
      ],
      "ratelimits": [
        {
          "name": "RATE_LIMIT",
          "namespace_id": "3003",
          "simple": {
            "limit": 1000,
            "period": 60
          }
        }
      ],
      "version_metadata": {
        "binding": "CF_VERSION_METADATA"
      }
    },
    "staging": {
      "name": "publish-staging",
      "workers_dev": false,
      "routes": [
        {
          "pattern": "registry-staging.claudinite.com/api/publish/*",
          "zone_name": "claudinite.com"
        },
        {
          "pattern": "registry-staging.claudinite.com/api/oidc/*",
          "zone_name": "claudinite.com"
        },
        {
          "pattern": "registry-staging.claudinite.com/api/dry-run/*",
          "zone_name": "claudinite.com"
        }
      ],
      "vars": {
        "WORKER": "publish",
        "ENVIRONMENT": "staging"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "registry-staging",
          "database_id": "00000000-0000-0000-0000-110000000001",
          "migrations_dir": "../../packages/schema/migrations"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "CACHE_KV",
          "id": "00000000000000000000120000000003"
        },
        {
          "binding": "TELEMETRY_KV",
          "id": "00000000000000000000120000000007"
        }
      ],
      "r2_buckets": [
        {
          "binding": "PACKS_STAGING",
          "bucket_name": "packs-staging-staging"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "NOTIFY_QUEUE",
            "queue": "notify-staging"
          }
        ]
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "SCOPE_COORDINATOR",
            "class_name": "ScopeCoordinator"
          },
          {
            "name": "QUOTA",
            "class_name": "Quota"
          },
          {
            "name": "ROOT_COORDINATOR",
            "class_name": "RootCoordinator"
          }
        ]
      },
      "exports": {
        "ScopeCoordinator": {
          "type": "durable-object",
          "storage": "sqlite"
        },
        "Quota": {
          "type": "durable-object",
          "storage": "sqlite"
        },
        "RootCoordinator": {
          "type": "durable-object",
          "storage": "sqlite"
        }
      },
      "services": [
        {
          "binding": "VALIDATOR",
          "service": "validator-staging"
        }
      ],
      "analytics_engine_datasets": [
        {
          "binding": "REQUEST_OUTCOMES",
          "dataset": "request_outcomes_staging"
        },
        {
          "binding": "DOMAIN_EVENTS",
          "dataset": "domain_events_staging"
        }
      ],
      "secrets_store_secrets": [
        {
          "binding": "STAGING_S3_ENDPOINT",
          "store_id": "00000000000000000000190000000004",
          "secret_name": "staging-s3-endpoint-staging"
        },
        {
          "binding": "STAGING_S3_ACCESS_KEY_ID",
          "store_id": "00000000000000000000190000000004",
          "secret_name": "staging-s3-access-key-id-staging"
        },
        {
          "binding": "STAGING_S3_SECRET_ACCESS_KEY",
          "store_id": "00000000000000000000190000000004",
          "secret_name": "staging-s3-secret-access-key-staging"
        },
        {
          "binding": "SELFTEST_HMAC_KEY",
          "store_id": "00000000000000000000190000000004",
          "secret_name": "selftest-hmac-key-staging"
        },
        {
          "binding": "IP_HASH_MASTER_KEY",
          "store_id": "00000000000000000000190000000004",
          "secret_name": "ip-hash-master-key-staging"
        },
        {
          "binding": "PRINCIPAL_HASH_KEY",
          "store_id": "00000000000000000000190000000004",
          "secret_name": "principal-hash-key-staging"
        }
      ],
      "ratelimits": [
        {
          "name": "RATE_LIMIT",
          "namespace_id": "2003",
          "simple": {
            "limit": 30,
            "period": 60
          }
        }
      ],
      "version_metadata": {
        "binding": "CF_VERSION_METADATA"
      }
    },
    "production": {
      "name": "publish",
      "workers_dev": false,
      "routes": [
        {
          "pattern": "registry.claudinite.com/api/publish/*",
          "zone_name": "claudinite.com"
        },
        {
          "pattern": "registry.claudinite.com/api/oidc/*",
          "zone_name": "claudinite.com"
        },
        {
          "pattern": "registry.claudinite.com/api/dry-run/*",
          "zone_name": "claudinite.com"
        },
        {
          "pattern": "registry-canary.claudinite.com/api/publish/*",
          "zone_name": "claudinite.com"
        },
        {
          "pattern": "registry-canary.claudinite.com/api/oidc/*",
          "zone_name": "claudinite.com"
        },
        {
          "pattern": "registry-canary.claudinite.com/api/dry-run/*",
          "zone_name": "claudinite.com"
        }
      ],
      "vars": {
        "WORKER": "publish",
        "ENVIRONMENT": "production"
      },
      "d1_databases": [
        {
          "binding": "DB",
          "database_name": "registry",
          "database_id": "00000000-0000-0000-0000-210000000001",
          "migrations_dir": "../../packages/schema/migrations"
        }
      ],
      "kv_namespaces": [
        {
          "binding": "CACHE_KV",
          "id": "00000000000000000000220000000003"
        },
        {
          "binding": "TELEMETRY_KV",
          "id": "00000000000000000000220000000007"
        }
      ],
      "r2_buckets": [
        {
          "binding": "PACKS_STAGING",
          "bucket_name": "packs-staging"
        }
      ],
      "queues": {
        "producers": [
          {
            "binding": "NOTIFY_QUEUE",
            "queue": "notify"
          }
        ]
      },
      "durable_objects": {
        "bindings": [
          {
            "name": "SCOPE_COORDINATOR",
            "class_name": "ScopeCoordinator"
          },
          {
            "name": "QUOTA",
            "class_name": "Quota"
          },
          {
            "name": "ROOT_COORDINATOR",
            "class_name": "RootCoordinator"
          }
        ]
      },
      "exports": {
        "ScopeCoordinator": {
          "type": "durable-object",
          "storage": "sqlite"
        },
        "Quota": {
          "type": "durable-object",
          "storage": "sqlite"
        },
        "RootCoordinator": {
          "type": "durable-object",
          "storage": "sqlite"
        }
      },
      "services": [
        {
          "binding": "VALIDATOR",
          "service": "validator"
        }
      ],
      "analytics_engine_datasets": [
        {
          "binding": "REQUEST_OUTCOMES",
          "dataset": "request_outcomes"
        },
        {
          "binding": "DOMAIN_EVENTS",
          "dataset": "domain_events"
        }
      ],
      "secrets_store_secrets": [
        {
          "binding": "STAGING_S3_ENDPOINT",
          "store_id": "00000000000000000000290000000004",
          "secret_name": "staging-s3-endpoint"
        },
        {
          "binding": "STAGING_S3_ACCESS_KEY_ID",
          "store_id": "00000000000000000000290000000004",
          "secret_name": "staging-s3-access-key-id"
        },
        {
          "binding": "STAGING_S3_SECRET_ACCESS_KEY",
          "store_id": "00000000000000000000290000000004",
          "secret_name": "staging-s3-secret-access-key"
        },
        {
          "binding": "SELFTEST_HMAC_KEY",
          "store_id": "00000000000000000000290000000004",
          "secret_name": "selftest-hmac-key"
        },
        {
          "binding": "IP_HASH_MASTER_KEY",
          "store_id": "00000000000000000000290000000004",
          "secret_name": "ip-hash-master-key"
        },
        {
          "binding": "PRINCIPAL_HASH_KEY",
          "store_id": "00000000000000000000290000000004",
          "secret_name": "principal-hash-key"
        }
      ],
      "ratelimits": [
        {
          "name": "RATE_LIMIT",
          "namespace_id": "1003",
          "simple": {
            "limit": 30,
            "period": 60
          }
        }
      ],
      "version_metadata": {
        "binding": "CF_VERSION_METADATA"
      }
    }
  }
}

{
  "name": "judge-local",
  "workers_dev": false,
  "preview_urls": false,
  "$schema": "../../node_modules/wrangler/config-schema.json",
  "main": "src/index.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "env": {
    "test": {
      "name": "judge-test",
      "workers_dev": false,
      "preview_urls": false,
      "vars": {
        "WORKER": "judge",
        "ENVIRONMENT": "test",
        "SELFTEST_HMAC_KEY": "test-selftest-hmac-key",
        "IP_HASH_MASTER_KEY": "test-ip-hash-master-key",
        "PRINCIPAL_HASH_KEY": "test-principal-hash-key",
        "ANALYTICS_READ_TOKEN": "test-analytics-read-token",
        "CF_AUDIT_READ_TOKEN": "test-cf-audit-read-token",
        "CF_ACCOUNT_ID": "test-account-id",
        "PUSHOVER_APP_TOKEN": "test-pushover-app-token",
        "PUSHOVER_USER_KEY": "test-pushover-user-ariel",
        "HOOK_SECRET_MONITORS": "test-hook-secret-monitors",
        "HOOK_SECRET_ISSUES": "test-hook-secret-issues",
        "HOOK_SECRET_WITNESS": "test-hook-secret-witness",
        "MUTE_HMAC_KEY": "test-mute-hmac-key",
        "CF_PLATFORM_READ_TOKEN": "test-cf-platform-read-token",
        "DATASET_SUFFIX": "_test",
        "DAILY_LOG_ALLOWANCE": "200000",
        "CI_TOKEN_IDS": "",
        "MAIL_FROM": "noreply@claudinite.com",
        "OPS_EMAIL": "ops@claudinite.com",
        "OPS_PAGE_URL": "https://registry-admin-test.claudinite.com/admin/ops",
        "PUBLIC_ORIGIN": "https://registry-test.claudinite.com",
        "SUPPORT_HOURS_UTC": "7-19",
        "CF_ZONE_ID": "test-zone",
        "QUEUE_IDS": "audit:test-queue-audit,validation:test-queue-validation"
      },
      "kv_namespaces": [
        {
          "binding": "GATES_KV",
          "id": "00000000000000000000020000000006"
        },
        {
          "binding": "TELEMETRY_KV",
          "id": "00000000000000000000020000000007"
        }
      ],
      "services": [
        {
          "binding": "ADMIN",
          "service": "admin-test"
        },
        {
          "binding": "ACCESS",
          "service": "fake-access"
        }
      ],
      "analytics_engine_datasets": [
        {
          "binding": "REQUEST_OUTCOMES",
          "dataset": "request_outcomes_test"
        },
        {
          "binding": "DOMAIN_EVENTS",
          "dataset": "domain_events_test"
        },
        {
          "binding": "GATE_RESULTS",
          "dataset": "gate_results_test"
        },
        {
          "binding": "BUDGET",
          "dataset": "budget_test"
        }
      ],
      "version_metadata": {
        "binding": "CF_VERSION_METADATA"
      }
    },
    "staging": {
      "name": "judge-staging",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        {
          "pattern": "registry-staging.claudinite.com/hooks/monitors",
          "zone_name": "claudinite.com"
        },
        {
          "pattern": "registry-staging.claudinite.com/hooks/issues",
          "zone_name": "claudinite.com"
        },
        {
          "pattern": "registry-staging.claudinite.com/hooks/witness",
          "zone_name": "claudinite.com"
        },
        {
          "pattern": "registry-staging.claudinite.com/hooks/mute",
          "zone_name": "claudinite.com"
        },
        {
          "pattern": "registry-staging.claudinite.com/gates/*",
          "zone_name": "claudinite.com"
        },
        {
          "pattern": "registry-staging.claudinite.com/probe-results",
          "zone_name": "claudinite.com"
        },
        {
          "pattern": "registry-staging.claudinite.com/judge/__selftest",
          "zone_name": "claudinite.com"
        }
      ],
      "triggers": {
        "crons": [
          "* * * * *"
        ]
      },
      "vars": {
        "WORKER": "judge",
        "ENVIRONMENT": "staging",
        "DATASET_SUFFIX": "_staging",
        "DAILY_LOG_ALLOWANCE": "200000",
        "CI_TOKEN_IDS": "",
        "MAIL_FROM": "noreply@claudinite.com",
        "OPS_EMAIL": "ops@claudinite.com",
        "OPS_PAGE_URL": "https://registry-admin-staging.claudinite.com/admin/ops",
        "PUBLIC_ORIGIN": "https://registry-staging.claudinite.com",
        "SUPPORT_HOURS_UTC": "7-19",
        "CF_ZONE_ID": "",
        "QUEUE_IDS": ""
      },
      "kv_namespaces": [
        {
          "binding": "GATES_KV",
          "id": "00000000000000000000120000000006"
        },
        {
          "binding": "TELEMETRY_KV",
          "id": "00000000000000000000120000000007"
        }
      ],
      "services": [
        {
          "binding": "ADMIN",
          "service": "admin-staging"
        }
      ],
      "analytics_engine_datasets": [
        {
          "binding": "REQUEST_OUTCOMES",
          "dataset": "request_outcomes_staging"
        },
        {
          "binding": "DOMAIN_EVENTS",
          "dataset": "domain_events_staging"
        },
        {
          "binding": "GATE_RESULTS",
          "dataset": "gate_results_staging"
        },
        {
          "binding": "BUDGET",
          "dataset": "budget_staging"
        }
      ],
      "secrets_store_secrets": [
        {
          "binding": "SELFTEST_HMAC_KEY",
          "store_id": "00000000000000000000190000000004",
          "secret_name": "selftest-hmac-key-staging"
        },
        {
          "binding": "IP_HASH_MASTER_KEY",
          "store_id": "00000000000000000000190000000004",
          "secret_name": "ip-hash-master-key-staging"
        },
        {
          "binding": "PRINCIPAL_HASH_KEY",
          "store_id": "00000000000000000000190000000004",
          "secret_name": "principal-hash-key-staging"
        },
        {
          "binding": "ANALYTICS_READ_TOKEN",
          "store_id": "00000000000000000000190000000004",
          "secret_name": "analytics-read-token-staging"
        },
        {
          "binding": "CF_AUDIT_READ_TOKEN",
          "store_id": "00000000000000000000190000000004",
          "secret_name": "cf-audit-read-token-staging"
        },
        {
          "binding": "CF_ACCOUNT_ID",
          "store_id": "00000000000000000000190000000004",
          "secret_name": "cf-account-id-staging"
        },
        {
          "binding": "PUSHOVER_APP_TOKEN",
          "store_id": "00000000000000000000190000000004",
          "secret_name": "pushover-app-token-staging"
        },
        {
          "binding": "PUSHOVER_USER_KEY",
          "store_id": "00000000000000000000190000000004",
          "secret_name": "pushover-user-key-staging"
        },
        {
          "binding": "HOOK_SECRET_MONITORS",
          "store_id": "00000000000000000000190000000004",
          "secret_name": "hook-secret-monitors-staging"
        },
        {
          "binding": "HOOK_SECRET_ISSUES",
          "store_id": "00000000000000000000190000000004",
          "secret_name": "hook-secret-issues-staging"
        },
        {
          "binding": "HOOK_SECRET_WITNESS",
          "store_id": "00000000000000000000190000000004",
          "secret_name": "hook-secret-witness-staging"
        },
        {
          "binding": "MUTE_HMAC_KEY",
          "store_id": "00000000000000000000190000000004",
          "secret_name": "mute-hmac-key-staging"
        },
        {
          "binding": "CF_PLATFORM_READ_TOKEN",
          "store_id": "00000000000000000000190000000004",
          "secret_name": "cf-platform-read-token-staging"
        }
      ],
      "send_email": [
        {
          "name": "EMAIL",
          "allowed_destination_addresses": [
            "ops@claudinite.com"
          ]
        }
      ],
      "version_metadata": {
        "binding": "CF_VERSION_METADATA"
      }
    },
    "production": {
      "name": "judge",
      "workers_dev": false,
      "preview_urls": false,
      "routes": [
        {
          "pattern": "registry.claudinite.com/hooks/monitors",
          "zone_name": "claudinite.com"
        },
        {
          "pattern": "registry.claudinite.com/hooks/issues",
          "zone_name": "claudinite.com"
        },
        {
          "pattern": "registry.claudinite.com/hooks/witness",
          "zone_name": "claudinite.com"
        },
        {
          "pattern": "registry.claudinite.com/hooks/mute",
          "zone_name": "claudinite.com"
        },
        {
          "pattern": "registry-canary.claudinite.com/gates/*",
          "zone_name": "claudinite.com"
        },
        {
          "pattern": "registry-canary.claudinite.com/probe-results",
          "zone_name": "claudinite.com"
        },
        {
          "pattern": "registry-canary.claudinite.com/judge/__selftest",
          "zone_name": "claudinite.com"
        }
      ],
      "triggers": {
        "crons": [
          "* * * * *"
        ]
      },
      "vars": {
        "WORKER": "judge",
        "ENVIRONMENT": "production",
        "DATASET_SUFFIX": "",
        "DAILY_LOG_ALLOWANCE": "200000",
        "CI_TOKEN_IDS": "",
        "MAIL_FROM": "noreply@claudinite.com",
        "OPS_EMAIL": "ops@claudinite.com",
        "OPS_PAGE_URL": "https://registry-admin.claudinite.com/admin/ops",
        "PUBLIC_ORIGIN": "https://registry.claudinite.com",
        "SUPPORT_HOURS_UTC": "7-19",
        "CF_ZONE_ID": "",
        "QUEUE_IDS": ""
      },
      "kv_namespaces": [
        {
          "binding": "GATES_KV",
          "id": "00000000000000000000220000000006"
        },
        {
          "binding": "TELEMETRY_KV",
          "id": "00000000000000000000220000000007"
        }
      ],
      "services": [
        {
          "binding": "ADMIN",
          "service": "admin"
        }
      ],
      "analytics_engine_datasets": [
        {
          "binding": "REQUEST_OUTCOMES",
          "dataset": "request_outcomes"
        },
        {
          "binding": "DOMAIN_EVENTS",
          "dataset": "domain_events"
        },
        {
          "binding": "GATE_RESULTS",
          "dataset": "gate_results"
        },
        {
          "binding": "BUDGET",
          "dataset": "budget"
        }
      ],
      "secrets_store_secrets": [
        {
          "binding": "SELFTEST_HMAC_KEY",
          "store_id": "00000000000000000000290000000004",
          "secret_name": "selftest-hmac-key"
        },
        {
          "binding": "IP_HASH_MASTER_KEY",
          "store_id": "00000000000000000000290000000004",
          "secret_name": "ip-hash-master-key"
        },
        {
          "binding": "PRINCIPAL_HASH_KEY",
          "store_id": "00000000000000000000290000000004",
          "secret_name": "principal-hash-key"
        },
        {
          "binding": "ANALYTICS_READ_TOKEN",
          "store_id": "00000000000000000000290000000004",
          "secret_name": "analytics-read-token"
        },
        {
          "binding": "CF_AUDIT_READ_TOKEN",
          "store_id": "00000000000000000000290000000004",
          "secret_name": "cf-audit-read-token"
        },
        {
          "binding": "CF_ACCOUNT_ID",
          "store_id": "00000000000000000000290000000004",
          "secret_name": "cf-account-id"
        },
        {
          "binding": "PUSHOVER_APP_TOKEN",
          "store_id": "00000000000000000000290000000004",
          "secret_name": "pushover-app-token"
        },
        {
          "binding": "PUSHOVER_USER_KEY",
          "store_id": "00000000000000000000290000000004",
          "secret_name": "pushover-user-key"
        },
        {
          "binding": "HOOK_SECRET_MONITORS",
          "store_id": "00000000000000000000290000000004",
          "secret_name": "hook-secret-monitors"
        },
        {
          "binding": "HOOK_SECRET_ISSUES",
          "store_id": "00000000000000000000290000000004",
          "secret_name": "hook-secret-issues"
        },
        {
          "binding": "HOOK_SECRET_WITNESS",
          "store_id": "00000000000000000000290000000004",
          "secret_name": "hook-secret-witness"
        },
        {
          "binding": "MUTE_HMAC_KEY",
          "store_id": "00000000000000000000290000000004",
          "secret_name": "mute-hmac-key"
        },
        {
          "binding": "CF_PLATFORM_READ_TOKEN",
          "store_id": "00000000000000000000290000000004",
          "secret_name": "cf-platform-read-token"
        }
      ],
      "send_email": [
        {
          "name": "EMAIL",
          "allowed_destination_addresses": [
            "ops@claudinite.com"
          ]
        }
      ],
      "version_metadata": {
        "binding": "CF_VERSION_METADATA"
      }
    }
  }
}

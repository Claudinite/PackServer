{
  "destinationBucket": "ops",
  "forbiddenFields": [
    "ClientIP",
    "ClientRequestURI",
    "ClientRequestQuery",
    "ClientRequestReferer",
    "ClientSrcPort"
  ],
  "retention": [
    {
      "prefix": "logs/http-requests/",
      "days": 90
    },
    {
      "prefix": "logs/firewall-events/",
      "days": 30
    }
  ],
  "jobs": [
    {
      "key": "http-cache-hits",
      "dataset": "http_requests",
      "prefix": "logs/http-requests/hits/{DATE}",
      "sampleRate": 0.1,
      "fields": [
        "CacheCacheStatus",
        "CacheResponseStatus",
        "CacheTieredFill",
        "ClientASN",
        "ClientCountry",
        "ClientRequestHost",
        "ClientRequestMethod",
        "ClientRequestPath",
        "ClientRequestProtocol",
        "ClientRequestUserAgent",
        "EdgeEndTimestamp",
        "EdgeResponseBytes",
        "EdgeResponseStatus",
        "EdgeStartTimestamp",
        "OriginResponseStatus",
        "RayID"
      ],
      "transformer": "http-requests.sql",
      "where": "CacheCacheStatus = 'hit'",
      "previewCacheStatus": "hit"
    },
    {
      "key": "http-cache-misses",
      "dataset": "http_requests",
      "prefix": "logs/http-requests/misses/{DATE}",
      "sampleRate": 1,
      "fields": [
        "CacheCacheStatus",
        "CacheResponseStatus",
        "CacheTieredFill",
        "ClientASN",
        "ClientCountry",
        "ClientRequestHost",
        "ClientRequestMethod",
        "ClientRequestPath",
        "ClientRequestProtocol",
        "ClientRequestUserAgent",
        "EdgeEndTimestamp",
        "EdgeResponseBytes",
        "EdgeResponseStatus",
        "EdgeStartTimestamp",
        "OriginResponseStatus",
        "RayID"
      ],
      "transformer": "http-requests.sql",
      "where": "(CacheCacheStatus IS NULL OR CacheCacheStatus <> 'hit')",
      "previewCacheStatus": "miss"
    },
    {
      "key": "firewall-events",
      "dataset": "firewall_events",
      "prefix": "logs/firewall-events/{DATE}",
      "sampleRate": 1,
      "fields": [
        "Action",
        "ClientASN",
        "ClientCountry",
        "ClientRequestHost",
        "ClientRequestMethod",
        "ClientRequestPath",
        "Datetime",
        "EdgeResponseStatus",
        "RayID",
        "RuleID",
        "Source"
      ]
    }
  ],
  "transformerDir": "transformers",
  "sampleRecord": {
    "CacheCacheStatus": "hit",
    "CacheResponseStatus": 200,
    "CacheTieredFill": false,
    "ClientASN": 64496,

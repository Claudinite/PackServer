{
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "\"$CLAUDE_PROJECT_DIR/.claudinite/bin/cn\" hook post-tool-use",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "\"$CLAUDE_PROJECT_DIR/.claudinite/bin/cn\" hook pre-tool-use",
            "type": "command"
          }
        ],
        "matcher": "*"
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "command": "\"$CLAUDE_PROJECT_DIR/.claudinite/bin/cn\" hook session-end",
            "type": "command"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "if npx --yes --prefer-offline @claudinite/setup@1.0.1 --repo \"$CLAUDE_PROJECT_DIR\"; then \"$CLAUDE_PROJECT_DIR/.claudinite/bin/cn\" hook session-start; fi",
            "type": "command"
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "command": "\"$CLAUDE_PROJECT_DIR/.claudinite/bin/cn\" hook stop",
            "type": "command"
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "command": "\"$CLAUDE_PROJECT_DIR/.claudinite/bin/cn\" hook user-prompt-submit",
            "type": "command"
          }
        ]
      }
    ]
  }
}

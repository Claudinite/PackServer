{
  "name": "packserver",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "docs:check": "node docs/testing/coverage.mjs --check",
    "check": "pnpm lint && pnpm typecheck && pnpm docs:check",
    "test": "turbo run test && pnpm test:scenarios",
    "test:scenarios": "vitest run --project scenarios --passWithNoTests",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@cloudflare/workers-types": "5.20261022.1",
    "@eslint/js": "10.0.1",
    "@modelcontextprotocol/server": "2.0.0",
    "@types/node": "^22.20.5",
    "agents": "0.23.0",
    "drizzle-kit": "0.31.11",
    "drizzle-orm": "0.45.4",
    "eslint": "10.13.0",
    "hono": "4.13.13",
    "jose": "6.2.13",
    "msw": "3.0.3",
    "turbo": "2.11.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "undici": "^7.29.1",
    "vitest": "5.0.5",
    "wrangler": "4.151.3",
    "zod": "4.6.7"
  }
}

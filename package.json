{
  "name": "packserver",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.28.0",
  "engines": { "node": ">=22.12" },
  "scripts": {
    "lint": "eslint .",
    "typecheck": "turbo run typecheck",
    "docs:check": "node docs/testing/coverage.mjs --check",
    "check": "pnpm lint && pnpm typecheck && node tools/check-rules.mjs",
    "test": "turbo run test && pnpm test:infra && pnpm test:scenarios",
    "test:infra": "vitest run --project infra",
    "test:scenarios": "vitest run --project scenarios --passWithNoTests",
    "changeset": "changeset"
  },
  "devDependencies": {
    "@changesets/cli": "3.0.3",
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.5",
    "eslint": "10.13.0",
    "turbo": "2.11.10",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.0",
    "vitest": "5.0.5"
  }
}
